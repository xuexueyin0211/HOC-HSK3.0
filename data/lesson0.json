  "hanziFormation": [
    {
      "title": "1. Tượng Hình (象形)",
      "desc": "Vẽ mô phỏng lại hình dáng thực tế của sự vật. Ví dụ: 日 (Mặt trời), 月 (Mặt trăng), 山 (Núi), 木 (Cây).",
      "bgColor": "#fdf2f8",
      "borderColor": "#fbcfe8",
      "titleColor": "#be185d",
      "img": "images/xiangxingzi.png"
    },
    {
      "title": "2. Chỉ Sự (指事)",
      "desc": "Dùng ký hiệu tượng trưng biểu thị khái niệm trừu tượng. Ví dụ: 上 (Trên), 下 (Dưới), 本 (Gốc cây).",
      "bgColor": "#f0f9ff",
      "borderColor": "#7dd3fc",
      "titleColor": "#0369a1",
      "img": "images/zhishizi.png"
    },
    {
      "title": "3. Hội Ý (会意)",
      "desc": "Ghép hai hay nhiều chữ tượng hình lại để tạo nghĩa mới. Ví dụ: 林 (Hai cái cây = Khu rừng), 明 (Mặt trời + Mặt trăng = Sáng).",
      "bgColor": "#fef3c7",
      "borderColor": "#fde68a",
      "titleColor": "#b45309",
      "img": "images/huiyizi.png"
    },
    {
      "title": "4. Hình Thanh (形声 - Chiếm 80%+)",
      "desc": "Gồm bộ thủ biểu nghĩa (Hình) + bộ phận biểu âm đọc (Thanh). Ví dụ: 妈 (Bộ Nữ 女 biểu nghĩa + chữ Mã 马 biểu âm).",
      "bgColor": "#faf5ff",
      "borderColor": "#d8b4fe",
      "titleColor": "#6b21a8",
      "img": "images/xingshengzi.png"
    },
    {
      "title": "5. Chuyển Chú (转注)",
      "desc": "Các chữ có cùng nguồn gốc bộ thủ, cùng nghĩa tương đương và có thể chú thích giải nghĩa cho nhau. Ví dụ: 考 (kǎo) và 老 (lǎo).",
      "bgColor": "#fdf2f8",
      "borderColor": "#fbcfe8",
      "titleColor": "#be185d"
    },
    {
      "title": "6. Giả Tá (假借)",
      "desc": "Mượn chữ có âm đọc giống hoặc gần giống để biểu thị từ mới chưa có chữ viết riêng. Ví dụ: 自 (zì - ban đầu nghĩa là cái mũi, sau mượn làm từ chỉ bản thân).",
      "bgColor": "#f0f9ff",
      "borderColor": "#7dd3fc",
      "titleColor": "#0369a1"
    }
  ]
}