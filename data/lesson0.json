      },
      {
        "final": "üan",
        "alone": "yuan",
        "example": "元 (yuán)",
        "rule": "Thêm y, bỏ dấu hai chấm"
      },
      {
        "final": "ün",
        "alone": "yun",
        "example": "云 (yún)",
        "rule": "Thêm y, bỏ dấu hai chấm"
      }
    ]
