  "pronunciationNotes": {
    "vowel_i_variations": {
      "note": "Cách đọc vần 'i' thay đổi theo phụ âm đầu đi kèm",
      "rules": [
        {
          "initials": ["z", "c", "s", "zh", "ch", "sh", "r"],
          "pronunciation": "ư"
        },
        {
          "initials": ["j", "q", "x", "b", "p", "m", "d", "t", "n", "l"],
          "pronunciation": "i"
        }
      ]
    },
    "vowel_u_umlaut_notes": {
      "note": "Quy tắc dành cho vần 'ü'",
      "rules": [
        "Vần 'ü' CHỈ đi với 5 phụ âm: j, q, x, n, l",
        "Khi viết với j, q, x → bỏ dấu hai chấm (viết là 'u') nhưng vẫn đọc là 'uy'. Ví dụ: ju (đọc là jǖ)",
        "Khi viết với n, l → giữ nguyên dấu hai chấm (nü, lü) để phân biệt với nu, lu"
      ]
    },
    "tone_mark_rules": {
      "note": "Quy tắc đặt dấu thanh trên nguyên âm chính",
      "priority": "a > o > e > i > u > ü",
      "examples": [
        "ao → đặt trên a (ǎo)",
        "uo → đặt trên o (uǒ)",
        "ie → đặt trên e (iě)"
      ],
      "exceptions": [
        "iu → dấu đặt trên u (iù)",
        "ui → dấu đặt trên i (uì)"
      ]
    }
  },
