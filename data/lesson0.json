  "sandhiRules": [
    {
      "title": "1. Hai thanh 3 đi liền nhau (3 + 3 ➔ 2 + 3; 3 + 3 + 3 ➔ 3 + 2 + 3 hoặc 2 + 2 + 3)",
      "desc": "Khi hai âm tiết mang thanh 3 đi liền nhau, âm tiết thứ nhất sẽ biến đổi phát âm thành <strong>thanh 2</strong>.\nKhi ba âm tiết mang thanh 3 đi liền nhau, có thể biến điệu là 3-2-3 hoặc 2-2-3.\n• Ví dụ: <strong>Nǐ hǎo</strong> (你好) ➔ Đọc là <strong>Ní hǎo</strong>\n• Ví dụ: <strong>Kěyǐ</strong> (可以) ➔ Đọc là <strong>Kéyǐ</strong>\n• Ví dụ: <strong>Wǒ hěn hǎo</strong> (我很好) ➔ Đọc là <strong>Wǒ hén hǎo</strong> hoặc <strong>wó hén hǎo</strong>",
      "bgColor": "#fdf2f8",
      "borderColor": "#ec4899",
      "titleColor": "#be185d"
    },
    {
      "title": "2. Biến điệu của chữ 不 (Bù)",
      "desc": "Chữ <strong>不 (bù)</strong> nguyên thể mang thanh 4. Khi đứng trước một âm tiết mang thanh 4 khác, <strong>bù</strong> chuyển sang đọc thành thanh 2 (<strong>bú</strong>).\n• Ví dụ: <strong>bù shì</strong> ➔ <strong>bú shì</strong>\n• Ví dụ: <strong>bù duì</strong> ➔ <strong>bú duì</strong>",
      "bgColor": "#f0f9ff",
      "borderColor": "#0284c7",
      "titleColor": "#0369a1"
    },
    {
      "title": "3. Biến điệu của chữ 一 (Yī)",
      "desc": "• Đứng độc lập hoặc cuối từ: đọc nguyên thanh 1 <strong>Yī</strong>.\n• Đứng trước thanh 4: chuyển sang đọc thanh 2 <strong>Yí</strong>.\n• Đứng trước thanh 1, 2, 3: chuyển sang đọc thanh 4 <strong>Yì</strong>.\n• Ví dụ: <strong>chū yī</strong>; <strong>xīngqī yī</strong>\n• Ví dụ: <strong>yī gè</strong> ➔ <strong>yí gè</strong>\n• Ví dụ: <strong>yī tiān</strong> ➔ <strong>yì tiān</strong>",
      "bgColor": "#fef3c7",
      "borderColor": "#d97706",
      "titleColor": "#b45309"
    },
    {
      "title": "4. Thanh Nhẹ",
      "desc": "Âm tiết mang thanh nhẹ không ghi dấu thanh điệu, được phát âm ngắn, nhẹ nhàng và tự nhiên.\n• Ví dụ: <strong>māma</strong> (妈妈 - Mẹ), <strong>xièxie</strong> (谢谢 - Cảm ơn)",
      "bgColor": "#faf5ff",
      "borderColor": "#9333ea",
      "titleColor": "#6b21a8"
    }
  ],
  "yW_Rules": {
    "note": "y và w là bán vận mẫu (thanh mẫu không chính thức), KHÔNG phải thanh mẫu thực thụ. Chúng dùng để viết cho các vần bắt đầu bằng i, u, ü khi đứng một mình.\n\"y\"đọc là \"d\" (trừ \"yi\"), \"w\"đọc là \"qu\" (trừ \"wu\")",
    "rules": [
      {
        "final": "i",
        "alone": "yi",
        "example": "一 (yī)",
        "rule": "Thêm y trước i"
      },
      {
        "final": "in",
        "alone": "yin",
        "example": "音 (yīn)",
        "rule": "Thêm y trước in"
      },
      {
        "final": "ing",
        "alone": "ying",
        "example": "英 (yīng)",
        "rule": "Thêm y trước ing"
      },
      {
        "final": "ia",
        "alone": "ya",
        "example": "鸭 (yā)",
        "rule": "Đổi i thành y"
      },
      {
        "final": "ie",
        "alone": "ye",
        "example": "也 (yě)",
        "rule": "Đổi i thành y"
      },
      {
        "final": "iao",
        "alone": "yao",
        "example": "要 (yào)",
        "rule": "Đổi i thành y"
      },
      {
        "final": "iu(iou)",
        "alone": "you",
        "example": "有 (yǒu)",
        "rule": "Đổi i thành y (bản chất của \"iu\" là \"iou\")"
      },
      {
        "final": "ian",
        "alone": "yan",
        "example": "眼 (yǎn)",
        "rule": "Đổi i thành y"
      },
      {
        "final": "iang",
        "alone": "yang",
        "example": "羊 (yáng)",
        "rule": "Đổi i thành y"
      },
      {
        "final": "iong",
        "alone": "yong",
        "example": "用 (yòng)",
        "rule": "Đổi i thành y"
      },
      {
        "final": "u",
        "alone": "wu",
        "example": "五 (wǔ)",
        "rule": "Thêm w trước u"
      },
      {
        "final": "ua",
        "alone": "wa",
        "example": "瓦 (wǎ)",
        "rule": "Đổi u thành w"
      },
      {
        "final": "uo",
        "alone": "wo",
        "example": "我 (wǒ)",
        "rule": "Đổi u thành w"
      },
      {
        "final": "uai",
        "alone": "wai",
        "example": "外 (wài)",
        "rule": "Đổi u thành w"
      },
      {
        "final": "ui",
        "alone": "wei",
        "example": "为 (wèi)",
        "rule": "Đổi u thành w"
      },
      {
        "final": "uan",
        "alone": "wan",
        "example": "万 (wàn)",
        "rule": "Đổi u thành w"
      },
      {
        "final": "uang",
        "alone": "wang",
        "example": "王 (wáng)",
        "rule": "Đổi u thành w"
      },
      {
        "final": "uen",
        "alone": "wen",
        "example": "问 (wèn)",
        "rule": "Đổi u thành w"
      },
      {
        "final": "ueng",
        "alone": "weng",
        "example": "翁 (wēng)",
